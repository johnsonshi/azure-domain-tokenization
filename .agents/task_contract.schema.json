{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task contract",
  "description": "One unit of delegated work in work_queue.jsonl (plan.md §19).",
  "type": "object",
  "required": ["id", "role", "objective", "inputs", "outputs", "acceptance_commands", "status", "attempt", "max_attempts", "depends_on"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^TASK-[0-9]{4}$"},
    "role": {
      "type": "string",
      "enum": ["orchestrator", "literature_researcher", "repo_scout", "licensing_reviewer",
                "corpus_engineer", "methodologist", "tokenizer_engineer", "benchmark_engineer",
                "statistician", "red_team_reviewer", "technical_writer"]
    },
    "objective": {"type": "string", "minLength": 8},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "acceptance_commands": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["ready", "in_progress", "blocked", "done", "failed"]},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "context_files": {"type": "array", "items": {"type": "string"}},
    "handoff": {
      "type": "object",
      "description": "Concise result summary written back on completion.",
      "properties": {
        "changed_files": {"type": "array", "items": {"type": "string"}},
        "commands": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string"},
        "risks": {"type": "string"},
        "next_task": {"type": "string"}
      }
    }
  }
}
