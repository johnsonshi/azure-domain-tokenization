# latexmk configuration — pdflatex + bibtex, portable for arXiv.
$pdf_mode = 1;            # pdflatex
$bibtex_use = 2;          # run bibtex, keep .bbl
$out_dir = 'arxiv/build';
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error %O %S';
$clean_ext = 'bbl nav snm run.xml';
